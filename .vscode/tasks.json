{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build and run",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Wno-sign-compare",
                "-Wno-unused-variable",
                "-Wno-unused-parameter",
                "-Wno-unused-but-set-variable",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Compile C++ file and create executable"
        },
        {
            "label": "Run C++",
            "type": "shell",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "dependsOn": ["build and run"],
            "problemMatcher": [],
            "detail": "Run the compiled executable"
        }
    ]
}